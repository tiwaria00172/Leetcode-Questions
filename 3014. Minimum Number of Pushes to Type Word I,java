class Solution {
    public int minimumPushes(String word) {
        int[] count = new int[26];
        for (char c : word.toCharArray()) {
            count[c - 'a']++;
        }
        
        java.util.Arrays.sort(count);
        
        int totalPushes = 0;
        int multiplier = 1;
        int countLetters = 0;
        
        for (int i = 25; i >= 0; i--) {
            if (count[i] == 0) {
                break;
            }
            totalPushes += count[i] * multiplier;
            countLetters++;
            if (countLetters % 8 == 0) {
                multiplier++;
            }
        }
        
        return totalPushes;
    }
}
