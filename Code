import java.util.*;

class Solution {
    public int[] countServers(int n, int[][] logs, int x, int[] queries) {

        int m = queries.length;
        int[] ans = new int[m];

        // Sort logs by time
        Arrays.sort(logs, (a, b) -> a[1] - b[1]);

        // Store query and original index
        int[][] q = new int[m][2];

        for (int i = 0; i < m; i++) {
            q[i][0] = queries[i];
            q[i][1] = i;
        }

        // Sort queries by time
        Arrays.sort(q, (a, b) -> a[0] - b[0]);

        // Frequency of requests per server
        int[] freq = new int[n + 1];

        int left = 0, right = 0;
        int activeServers = 0;

        for (int i = 0; i < m; i++) {

            int t = q[i][0];
            int start = t - x;

            // Add logs within the right boundary
            while (right < logs.length && logs[right][1] <= t) {

                int server = logs[right][0];

                if (freq[server] == 0) {
                    activeServers++;
                }

                freq[server]++;
                right++;
            }

            // Remove logs before the left boundary
            while (left < right && logs[left][1] < start) {

                int server = logs[left][0];

                freq[server]--;

                if (freq[server] == 0) {
                    activeServers--;
                }

                left++;
            }

            // Store answer at original query index
            ans[q[i][1]] = n - activeServers;
        }

        return ans;
    }
}
